{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "User": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/UserProfile"
        }
      }
    },
    "UserProfile": {
      "type": "object",
      "properties": {
        "avatar": {
          "type": "string"
        }
      }
    }
  }
}
