{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "User": {
      "type": "object",
      "$id": "https://swagger.io/schemas/user",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "profileAvatar": {
          "$ref": "/schemas/user-profile/avatar"
        }
      }
    },
    "UserProfile": {
      "$id": "https://swagger.io/schemas/user-profile",
      "type": "object",
      "properties": {
        "avatar": {
          "$id": "/schemas/user-profile/avatar",
          "type": "string"
        }
      }
    }
  }
}
