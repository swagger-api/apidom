{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "User": {
      "$id": "/$defs/user",
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "profile": {
          "$ref": "/$defs/user-profile#user-profile"
        }
      }
    },
    "UserProfile": {
      "$id": "/$defs/user-profile",
      "$anchor": "user-profile",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        }
      }
    }
  }
}
