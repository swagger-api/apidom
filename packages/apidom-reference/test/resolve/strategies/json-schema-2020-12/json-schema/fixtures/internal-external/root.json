{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "User": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/UserProfile"
        }
      }
    },
    "UserProfile": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        }
      }
    },
    "Order": {
      "$ref": "./ex.json#/$defs/Order"
    }
  }
}
